{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "../dist/server",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "declaration": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/test/**/*",
    "src/**/*.test.ts"
  ]
}
